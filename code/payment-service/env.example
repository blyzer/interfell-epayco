# Environment variables template
# Copy to .env and fill with real values

# ============ Server ============
PORT=3000
NODE_ENV=development

# ============ Database ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_service
DATABASE_POOL_SIZE=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# ============ External Services ============
FRAUD_SERVICE_URL=http://localhost:3001
FRAUD_SERVICE_TIMEOUT_MS=30000
FRAUD_SERVICE_RETRY_ATTEMPTS=3

BANK_SERVICE_URL=https://api.bank.example.com
BANK_API_KEY=your-secret-bank-api-key
BANK_SERVICE_TIMEOUT_MS=30000
BANK_SERVICE_RETRY_ATTEMPTS=3

# ============ Event Publishing ============
# TODO: Implementar SNS/SQS
EVENT_PUBLISHER_TYPE=sqs
AWS_SQS_PAYMENT_EVENTS_URL=https://sqs.us-east-1.amazonaws.com/123456789/payment-events
AWS_REGION=us-east-1

# ============ Logging ============
LOG_LEVEL=info
LOG_FORMAT=json

# ============ Security ============
JWT_SECRET=your-jwt-secret-key
API_KEY_HEADER=X-API-Key

# ============ Monitoring ============
# TODO: Implementar CloudWatch
ENABLE_XRAY=false
ENABLE_CLOUDWATCH=false
