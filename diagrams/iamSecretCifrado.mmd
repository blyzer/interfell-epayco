graph TB
subgraph "IAM Role Hierarchy"
ADMIN["Admin Role<br/>iam:*, organizations:*<br/>RESTRICTED: 2 personas"]
DEVOPS["DevOps Role (CI/CD)<br/>ECS Deploy, ECR Push<br/>CloudFormation Stack"]
APP_ROLE["Application Role (ECS Task)<br/>Secrets: GetSecretValue<br/>DynamoDB: PutItem, GetItem<br/>S3: GetObject<br/>Logs: PutLogEvents"]
ANALYTICS["Analytics Role<br/>RDS: SELECT (read-only)<br/>S3: GetObject<br/>Athena: QueryExecution"]
CROSS_ACCOUNT["Cross-Account Role<br/>AssumeRole: 15 min<br/>IP whitelist, MFA required"]
end
subgraph "Secrets Management"
SM["AWS Secrets Manager<br/>Automatic rotation"]
DB_SECRET["prod/payment-service/database-url<br/>Rotation: 90 días"]
JWT_SECRET["prod/payment-service/jwt-secret<br/>Rotation: 365 días"]
STRIPE_KEY["prod/payment-service/stripe-api-key<br/>Rotation: Manual"]
end
subgraph "Encryption"
ATREST["At-Rest (AES-256)<br/>RDS, DynamoDB, S3<br/>via AWS KMS"]
INTRANSIT["In-Transit (TLS 1.3)<br/>CloudFront ↔ User<br/>ALB ↔ ECS<br/>ECS ↔ RDS (SSL required)"]
CERT["Certificates<br/>External: ACM (auto-renewed)<br/>Internal: Self-signed + KMS"]
end
ADMIN -->|Manages| DEVOPS
DEVOPS -->|Deploys| APP_ROLE
APP_ROLE -->|Accesses| SM
SM -->|Stores| DB_SECRET
SM -->|Stores| JWT_SECRET
SM -->|Stores| STRIPE_KEY
APP_ROLE -->|Uses| ATREST
APP_ROLE -->|Uses| INTRANSIT
APP_ROLE -->|Uses| CERT
