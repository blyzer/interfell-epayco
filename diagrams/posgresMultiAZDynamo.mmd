graph TB
subgraph "Write Path"
APP["ECS App Task"]
APP -->|Write-through| RDS_PRIMARY["PostgreSQL Primary<br/>RDS Multi-AZ<br/>Sync replication"]
RDS_PRIMARY -->|Replication| RDS_STANDBY["RDS Standby<br/>(120s failover)"]
RDS_PRIMARY -->|Async| DDB["DynamoDB<br/>Audit log"]
end
subgraph "Read Path"
ANALYTICS["Analytics Tasks"]
ANALYTICS -->|Read-only| RDS_REPLICA["RDS Read Replica<br/>for reporting"]
end
subgraph "Cache Layer"
CACHE_APP["ECS Apps"]
CACHE_APP -->|L1 Cache| REDIS["ElastiCache Redis<br/>Cluster Multi-AZ<br/>Hot data"]
REDIS -->|Cache hits| RESPONSE["⚡ <100ms response"]
end
